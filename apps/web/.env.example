# Required. `npm run build` fails without the URL and a key; there is no
# built-in default project. A legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted
# in place of the publishable key (the publishable key wins if both are set).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_CONTENTSQUARE_CLIENT_ID=

# Server-only. Used by /api/invite-collaborator to send the "you've been
# invited to plan together" email through Supabase Auth. Never expose this
# to the browser — it bypasses RLS entirely. Supabase's Vercel integration
# installs this automatically. Legacy deployments may instead keep using
# SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Server-only. Used by /api/translate (the form builder's auto-translate).
# Optional: when empty the route answers 503 and the builder tells the couple
# to write the other language by hand. Nothing else depends on it.
ANTHROPIC_API_KEY=
# Optional. Pins the model /api/translate uses. When empty, the route uses the
# newest Opus your key can list (re-checked hourly), so a new Opus release is
# picked up automatically. Pin it when price and behaviour must stay put.
ANTHROPIC_TRANSLATE_MODEL=

# Optional. Cloudflare Turnstile site key (public) for invisible sign-up bot
# protection. Leave empty and no challenge runs. Set it, and redeploy, BEFORE
# enabling CAPTCHA protection in the Supabase dashboard (the secret goes there,
# not here) — see "Bot protection on sign-up" in the README.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional. Canonical origin used for the redirect link in invite emails sent
# by /api/invite-collaborator. Supabase only honours allow-listed redirect
# targets, so set this wherever the request's own host isn't one.
NEXT_PUBLIC_SITE_URL=
