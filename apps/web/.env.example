NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only — never prefix with NEXT_PUBLIC_. Required for guest OTP
# sign-in (request_guest_otp / request_guest_email_otp are service_role-only
# on purpose, since they return a plaintext code to be emailed).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BREVO_TRANSACTIONAL_EMAIL_API_KEY=your-brevo-api-key
BREVO_TRANSACTIONAL_EMAIL_SENDER=hello@yourdomain.com
